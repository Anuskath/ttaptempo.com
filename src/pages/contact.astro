---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - Tap Tempo | ttaptempo.com"
  description="Get in touch with the ttaptempo.com development team for feature suggestions, questions, or bug reports."
  canonicalPath="/contact/"
>
  <div class="max-w-3xl mx-auto px-4 py-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-4">
      <span>Support &amp; Inquiries</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 mb-4">
      Contact Us
    </h1>
    <p class="text-neutral-600 dark:text-neutral-400 mb-8">
      We love hearing from musicians, sound designers, and producers. Send us your feedback, feature requests, or report an issue.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
      
      <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
        <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <h3 class="font-bold text-base text-neutral-900 dark:text-neutral-100 mb-1">Direct Email</h3>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-3">For general inquiries, partnerships, and developer questions:</p>
        <a href="mailto:hello@ttaptempo.com" class="text-sm font-mono font-medium text-blue-600 dark:text-blue-400 hover:underline">
          hello@ttaptempo.com
        </a>
      </div>

      <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-base text-neutral-900 dark:text-neutral-100 mb-1">Response Time</h3>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-3">Our technical team reviews all incoming inquiries promptly:</p>
        <span class="text-xs font-mono px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
          Typically within 24–48 hours
        </span>
      </div>

    </div>

    <!-- Contact Form (Interactive Front-End) -->
    <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/60 p-6 sm:p-8">
      <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-4">Send a Message</h3>
      <form id="contact-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Your Name</label>
            <input type="text" required class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 text-sm focus:outline-none focus:ring-1 focus:ring-neutral-400" placeholder="Alex Rivers" />
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Your Email</label>
            <input type="email" required class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 text-sm focus:outline-none focus:ring-1 focus:ring-neutral-400" placeholder="alex@producer.com" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Subject</label>
          <select class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 text-sm focus:outline-none focus:ring-1 focus:ring-neutral-400">
            <option>Feature Suggestion</option>
            <option>BPM Accuracy / Timing Feedback</option>
            <option>Bug Report</option>
            <option>General Question</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1">Message</label>
          <textarea rows="4" required class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 text-sm focus:outline-none focus:ring-1 focus:ring-neutral-400" placeholder="Tell us your suggestions or experience..."></textarea>
        </div>

        <button type="submit" class="px-5 py-2.5 rounded-lg bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black font-semibold text-sm hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors cursor-pointer">
          Send Message
        </button>
        <span id="contact-success" class="hidden text-xs text-emerald-600 dark:text-emerald-400 font-medium ml-3">
          ✓ Thank you! Your message has been prepared.
        </span>
      </form>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('contact-success') as HTMLElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      form.reset();
      setTimeout(() => successMsg.classList.add('hidden'), 4000);
    });
  }
</script>
