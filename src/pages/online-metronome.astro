---
import Layout from '../layouts/Layout.astro';
import AudioMetronome from '../components/AudioMetronome.astro';
import TapPad from '../components/TapPad.astro';
---

<Layout
  title="Tap Tempo Metronome - Free Online Metronome Tool | ttaptempo.com"
  description="Free online tap tempo metronome with synthesized acoustic sounds, downbeat accents, custom time signatures (4/4, 3/4, 6/8), and visual beat pulsing."
  keywords="tap tempo metronome, metronome tap tempo, online metronome, tap metronome, practice metronome online"
  canonicalPath="/online-metronome/"
>
  <div class="py-6 px-4 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span>Online Metronome</span>
    </div>
  </div>

  <AudioMetronome />
  <TapPad />

  <!-- Dedicated Metronome Guide -->
  <section class="max-w-4xl mx-auto px-4 py-12 border-t border-neutral-200 dark:border-neutral-800">
    <article class="prose prose-neutral dark:prose-invert max-w-none text-sm sm:text-base">
      <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-4">
        Master Your Rhythm with a Free Online Tap Tempo Metronome
      </h2>
      <p>
        Consistent timing is the foundation of musical excellence. Our <strong>online metronome</strong> combines instant <strong>metronome tap tempo</strong> calculation with drift-free audio playback. Whether you are practicing classical piano etudes, guitar arpeggios, or drum rudiments, this tool keeps your tempo steady.
      </p>
      <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mt-6 mb-3">
        Key Metronome Features
      </h3>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Time Signatures with Accented Downbeats:</strong> Switch between 4/4 common time, 3/4 waltz, 2/4 march, and 6/8 compound time.</li>
        <li><strong>Authentic Instrument Sounds:</strong> Select from natural woodblocks, digital beeps, vintage 808 cowbells, and studio hi-hats.</li>
        <li><strong>Keyboard Shortcuts:</strong> Hit Enter or P to play and pause without taking your hands off your instrument.</li>
      </ul>
    </article>
  </section>
</Layout>
