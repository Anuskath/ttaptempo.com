---
import Layout from '../layouts/Layout.astro';
import TapPad from '../components/TapPad.astro';
import AudioMetronome from '../components/AudioMetronome.astro';
import DelayCalculator from '../components/DelayCalculator.astro';
import TempoReferenceGuide from '../components/TempoReferenceGuide.astro';
import HomeSeoArticle from '../components/HomeSeoArticle.astro';
import { TRANSLATIONS } from '../i18n/translations';

const en = TRANSLATIONS.en;
---

<Layout
  title={en.meta.title}
  description={en.meta.description}
  keywords={en.meta.keywords}
  canonicalPath="/"
  lang="en"
>
  <TapPad lang="en" />
  <AudioMetronome lang="en" />
  <DelayCalculator lang="en" />
  <TempoReferenceGuide lang="en" />
  <HomeSeoArticle lang="en" />
</Layout>
