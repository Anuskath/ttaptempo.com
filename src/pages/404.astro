---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Beat Not Found | ttaptempo.com"
  description="The page you requested could not be found or has dropped out of rhythm. Return to ttaptempo.com to measure BPM and practice with our online metronome."
  canonicalPath="/404.html"
  noindex={true}
>
  <div class="relative w-full py-20 sm:py-28 px-4 flex flex-col items-center justify-center text-center aurora-mesh-light min-h-[75vh]">
    <div class="max-w-xl mx-auto">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xs text-xs font-mono font-medium text-neutral-600 dark:text-neutral-400 mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Error 404 • Out of Tempo</span>
      </div>

      <!-- Musical Sound Wave Flatline Graphic -->
      <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-3xl bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black flex items-center justify-center mb-6 shadow-xl shadow-amber-500/10">
        <svg class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12h5l2-8 5 16 3-8h5"></path>
          <circle cx="12" cy="12" r="1" fill="currentColor"></circle>
        </svg>
      </div>

      <!-- Hero 404 Text -->
      <h1 class="font-mono text-7xl sm:text-9xl font-black tracking-tighter text-neutral-950 dark:text-neutral-50 mb-3">
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 mb-3">
        Beat Dropped: Page Not Found
      </h2>

      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mb-8 max-w-md mx-auto leading-relaxed">
        The track you were looking for seems to have faded out or never existed. Let’s get you back in rhythm with our timing tools below.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <a
          href="/"
          class="px-6 py-3 rounded-xl bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black font-semibold text-sm hover:opacity-90 transition-opacity shadow-md inline-flex items-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Return to Tap Tempo</span>
        </a>
        <a
          href="/#tempo-guide"
          class="px-5 py-3 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200 font-semibold text-sm hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
        >
          Explore Tempo Guide
        </a>
      </div>

      <!-- Quick Directory of Tools -->
      <div class="pt-8 border-t border-neutral-200 dark:border-neutral-800 text-left">
        <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 text-center mb-4">
          Quick Recovery Links
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <a
            href="/bpm-counter/"
            class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors text-center block"
          >
            <div class="text-xs font-bold text-neutral-900 dark:text-neutral-100">BPM Counter</div>
            <div class="text-[10px] text-neutral-500">Tap spacebar</div>
          </a>
          <a
            href="/online-metronome/"
            class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors text-center block"
          >
            <div class="text-xs font-bold text-neutral-900 dark:text-neutral-100">Online Metronome</div>
            <div class="text-[10px] text-neutral-500">Audio playback</div>
          </a>
          <a
            href="/delay-calculator/"
            class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors text-center block col-span-2 sm:col-span-1"
          >
            <div class="text-xs font-bold text-neutral-900 dark:text-neutral-100">Delay Sync</div>
            <div class="text-[10px] text-neutral-500">Guitar &amp; DAW ms</div>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
