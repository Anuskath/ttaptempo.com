---
import { TRANSLATIONS } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = TRANSLATIONS[lang]?.ui || TRANSLATIONS.en.ui;
---

<section id="metronome" class="relative w-full py-12 px-4 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40">
  <div class="max-w-4xl mx-auto">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-xs font-mono font-medium text-neutral-600 dark:text-neutral-400 mb-2">
          <span>Zero Audio Latency</span>
          <span>•</span>
          <span>Synthesized Web Audio</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          {t.metronomeTitle}
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
          {t.metronomeSubtitle}
        </p>
      </div>

      <!-- Quick Status -->
      <div id="metronome-status-badge" class="inline-flex items-center gap-2 text-xs font-mono px-3 py-1.5 rounded-lg bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 self-start sm:self-auto" data-play-text={t.play} data-stop-text={t.stop}>
        <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
        <span>Stopped</span>
      </div>
    </div>

    <!-- Metronome Controller Card -->
    <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 sm:p-8 shadow-sm">
      
      <!-- Visual Beat Pulse Indicator (Dots for 1, 2, 3, 4) -->
      <div class="flex items-center justify-center gap-4 sm:gap-6 py-6 mb-6 rounded-2xl bg-neutral-100/70 dark:bg-neutral-950/60 border border-neutral-200/60 dark:border-neutral-800/60">
        <div id="beat-dots-container" class="flex items-center gap-3 sm:gap-5">
          <!-- Dynamically populated beat dots -->
        </div>
      </div>

      <!-- Main Controls Grid: Play Button + Sliders + Selectors -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        
        <!-- Left: Giant Play/Pause Action Button -->
        <div class="md:col-span-4 flex flex-col items-center justify-center">
          <button
            id="metronome-play-btn"
            type="button"
            class="w-full sm:w-48 h-16 sm:h-20 rounded-2xl bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black font-bold text-base sm:text-lg flex items-center justify-center gap-3 shadow-md hover:bg-neutral-800 dark:hover:bg-neutral-200 active:scale-98 transition-all cursor-pointer select-none"
          >
            <!-- Play Icon -->
            <svg id="metro-icon-play" class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <!-- Pause Icon -->
            <svg id="metro-icon-pause" class="w-6 h-6 fill-current hidden" viewBox="0 0 24 24">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
            <span id="metro-btn-label">Play Beat</span>
          </button>
          <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 mt-2">Shortcut: Enter or P</span>
        </div>

        <!-- Center & Right: Fine Tune Slider, Sound Type, Time Signature -->
        <div class="md:col-span-8 flex flex-col gap-5">
          
          <!-- Tempo Slider & Numeric Input -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="metro-bpm-slider" class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider">
                Metronome Tempo
              </label>
              <div class="flex items-center gap-1">
                <input 
                  id="metro-bpm-input" 
                  type="number" 
                  min="20" 
                  max="360" 
                  value="120" 
                  class="w-16 px-2 py-1 rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 font-mono text-sm font-bold text-neutral-900 dark:text-neutral-100 text-right focus:outline-none focus:ring-1 focus:ring-neutral-400"
                />
                <span class="text-xs font-mono text-neutral-500">BPM</span>
              </div>
            </div>
            
            <input 
              id="metro-bpm-slider" 
              type="range" 
              min="30" 
              max="280" 
              value="120" 
              class="w-full h-2 rounded-lg bg-neutral-200 dark:bg-neutral-800 appearance-none cursor-pointer accent-neutral-900 dark:accent-neutral-100"
            />
          </div>

          <!-- Selectors: Sound Instrument & Time Signature -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            
            <!-- Sound Select -->
            <div>
              <label for="metro-sound-select" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">
                Sound Instrument
              </label>
              <select id="metro-sound-select" class="w-full rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 px-3 py-2 text-xs font-medium text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                <option value="woodblock" selected>🪵 Woodblock</option>
                <option value="beep">🔔 Digital Beep</option>
                <option value="cowbell">🪇 808 Cowbell</option>
                <option value="hihat">🥁 Studio Hi-Hat</option>
                <option value="kick">💥 808 Sub Kick</option>
              </select>
            </div>

            <!-- Time Signature -->
            <div>
              <label for="metro-sig-select" class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">
                Time Signature
              </label>
              <select id="metro-sig-select" class="w-full rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 px-3 py-2 text-xs font-medium text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-400">
                <option value="4" selected>4/4 (Common Time)</option>
                <option value="3">3/4 (Waltz)</option>
                <option value="2">2/4 (March)</option>
                <option value="6">6/8 (Compound)</option>
                <option value="1">1/4 (No Accent)</option>
              </select>
            </div>

            <!-- Volume Slider -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="metro-vol-slider" class="text-xs font-medium text-neutral-600 dark:text-neutral-400">
                  Volume
                </label>
                <span id="metro-vol-label" class="text-[11px] font-mono text-neutral-500">80%</span>
              </div>
              <input 
                id="metro-vol-slider" 
                type="range" 
                min="0" 
                max="100" 
                value="80" 
                class="w-full h-2 rounded-lg bg-neutral-200 dark:bg-neutral-800 appearance-none cursor-pointer accent-neutral-900 dark:accent-neutral-100 mt-2"
              />
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<script>
  import { metronomeEngine, type SoundType } from '../utils/audioMetronome';

  // DOM Elements
  const playBtn = document.getElementById('metronome-play-btn') as HTMLButtonElement;
  const iconPlay = document.getElementById('metro-icon-play') as HTMLElement;
  const iconPause = document.getElementById('metro-icon-pause') as HTMLElement;
  const btnLabel = document.getElementById('metro-btn-label') as HTMLElement;
  const statusBadge = document.getElementById('metronome-status-badge') as HTMLElement;
  const bpmSlider = document.getElementById('metro-bpm-slider') as HTMLInputElement;
  const bpmInput = document.getElementById('metro-bpm-input') as HTMLInputElement;
  const soundSelect = document.getElementById('metro-sound-select') as HTMLSelectElement;
  const sigSelect = document.getElementById('metro-sig-select') as HTMLSelectElement;
  const volSlider = document.getElementById('metro-vol-slider') as HTMLInputElement;
  const volLabel = document.getElementById('metro-vol-label') as HTMLElement;
  const beatDotsContainer = document.getElementById('beat-dots-container') as HTMLElement;

  let currentMetroBpm = 120;
  let currentBeatsCount = 4;

  // Render visual dots for each beat in the measure
  function renderBeatDots(totalBeats: number) {
    beatDotsContainer.innerHTML = '';
    currentBeatsCount = totalBeats;

    for (let i = 0; i < totalBeats; i++) {
      const dot = document.createElement('div');
      dot.id = `beat-dot-${i}`;
      // Beat 1 dot is styled slightly larger with accent border
      const isFirst = i === 0;
      dot.className = `w-4 h-4 sm:w-5 sm:h-5 rounded-full transition-all duration-75 ${
        isFirst 
          ? 'border-2 border-neutral-900 dark:border-neutral-100 bg-neutral-300 dark:bg-neutral-700' 
          : 'bg-neutral-200 dark:bg-neutral-800'
      }`;
      beatDotsContainer.appendChild(dot);
    }
  }

  // Handle pulse visual animation on beat
  function onBeatFlash(beatIndex: number, totalBeats: number) {
    for (let i = 0; i < totalBeats; i++) {
      const dot = document.getElementById(`beat-dot-${i}`);
      if (!dot) continue;
      
      if (i === beatIndex) {
        // Flash active beat
        if (i === 0) {
          dot.className = 'w-4 h-4 sm:w-5 sm:h-5 rounded-full scale-125 bg-emerald-500 shadow-md shadow-emerald-500/50 transition-transform duration-75';
        } else {
          dot.className = 'w-4 h-4 sm:w-5 sm:h-5 rounded-full scale-110 bg-neutral-900 dark:bg-neutral-100 transition-transform duration-75';
        }
      } else {
        const isFirst = i === 0;
        dot.className = `w-4 h-4 sm:w-5 sm:h-5 rounded-full transition-all duration-150 ${
          isFirst 
            ? 'border-2 border-neutral-900 dark:border-neutral-100 bg-neutral-300 dark:bg-neutral-700' 
            : 'bg-neutral-200 dark:bg-neutral-800'
        }`;
      }
    }
  }

  // Sync BPM changes
  function updateMetronomeBpm(newBpm: number) {
    currentMetroBpm = Math.max(20, Math.min(360, Math.round(newBpm)));
    bpmSlider.value = currentMetroBpm.toString();
    bpmInput.value = currentMetroBpm.toString();
    metronomeEngine.setBpm(currentMetroBpm);
  }

  function togglePlay() {
    if (metronomeEngine.getIsPlaying()) {
      metronomeEngine.stop();
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      btnLabel.textContent = 'Play Beat';
      statusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-neutral-400"></span><span>Stopped</span>';
      // Reset dots
      renderBeatDots(currentBeatsCount);
    } else {
      metronomeEngine.start(currentMetroBpm);
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      btnLabel.textContent = 'Stop Metronome';
      statusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span><span class="text-emerald-600 dark:text-emerald-400 font-bold">Playing</span>';
    }
  }

  // Initialize Web Audio Engine Callbacks
  metronomeEngine.setOnBeat(onBeatFlash);
  renderBeatDots(4);

  // Event Listeners
  playBtn.addEventListener('click', togglePlay);

  bpmSlider.addEventListener('input', () => {
    updateMetronomeBpm(parseFloat(bpmSlider.value));
    window.dispatchEvent(new CustomEvent('set-manual-bpm', { detail: { bpm: currentMetroBpm } }));
  });

  bpmInput.addEventListener('change', () => {
    updateMetronomeBpm(parseFloat(bpmInput.value) || 120);
    window.dispatchEvent(new CustomEvent('set-manual-bpm', { detail: { bpm: currentMetroBpm } }));
  });

  soundSelect.addEventListener('change', () => {
    metronomeEngine.setSound(soundSelect.value as SoundType);
  });

  sigSelect.addEventListener('change', () => {
    const beats = parseInt(sigSelect.value, 10);
    metronomeEngine.setTimeSignature(beats);
    renderBeatDots(beats);
  });

  volSlider.addEventListener('input', () => {
    const vol = parseInt(volSlider.value, 10);
    volLabel.textContent = `${vol}%`;
    metronomeEngine.setVolume(vol / 100);
  });

  // Listen to BPM change events from Tap Pad
  window.addEventListener('bpm-change', ((e: CustomEvent) => {
    if (e.detail.bpm > 0) {
      updateMetronomeBpm(e.detail.bpm);
    }
  }) as EventListener);

  // Keyboard shortcut: 'Enter' or 'P' to toggle metronome
  window.addEventListener('keydown', (e) => {
    const tag = (document.activeElement?.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'select' || tag === 'textarea') return;

    if (e.code === 'Enter' || e.key === 'p' || e.key === 'P') {
      e.preventDefault();
      togglePlay();
    }
  });
</script>
