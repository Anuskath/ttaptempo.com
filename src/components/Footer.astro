---
import { LANGUAGES, SUPPORTED_LANG_CODES } from '../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
---

<footer class="w-full border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-black text-neutral-600 dark:text-neutral-400 py-12 px-4 transition-colors">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      
      <!-- Column 1: Brand Info -->
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-3 group">
          <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-neutral-100 flex items-center justify-center text-white dark:text-black">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10v4"></path>
              <path d="M6 7v10"></path>
              <path d="M10 4v16"></path>
              <path d="M14 8v8"></path>
              <path d="M18 6v12"></path>
              <path d="M22 10v4"></path>
            </svg>
          </div>
          <span class="font-bold text-lg text-neutral-900 dark:text-neutral-100">Tap Tempo</span>
        </a>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 max-w-sm mb-4 leading-relaxed">
          The precision online tap tempo BPM counter and interactive metronome for musicians, DJs, sound designers, and music producers. 100% free with zero accounts and zero tracking.
        </p>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-neutral-100 dark:bg-neutral-900 text-xs font-mono text-neutral-600 dark:text-neutral-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>ttaptempo.com</span>
        </div>
      </div>

      <!-- Column 2: Tools Navigation -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-900 dark:text-neutral-200 mb-3">
          Tools
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/bpm-counter/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">BPM Counter &amp; Tapper</a></li>
          <li><a href="/online-metronome/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Online Metronome</a></li>
          <li><a href="/delay-calculator/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Delay Pedal &amp; Reverb Sync</a></li>
          <li><a href="/#tempo-guide" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Italian Tempo Markings</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal & Company -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-900 dark:text-neutral-200 mb-3">
          Information
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/about/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">About Us</a></li>
          <li><a href="/contact/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Contact Support</a></li>
          <li><a href="/privacy-policy/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Languages Directory in Footer (SEO Internal Link Juice) -->
    <div class="pt-6 pb-6 border-t border-neutral-100 dark:border-neutral-900">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
        <span class="font-mono text-[11px] uppercase tracking-wider text-neutral-400">Languages:</span>
        <div class="flex flex-wrap items-center gap-3 text-neutral-600 dark:text-neutral-400">
          {SUPPORTED_LANG_CODES.map((code) => {
            const l = LANGUAGES[code];
            const isSelected = code === lang;
            return (
              <a
                href={l.path}
                class={`hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors inline-flex items-center gap-1 ${
                  isSelected ? 'font-bold text-neutral-950 dark:text-neutral-50 underline underline-offset-4' : ''
                }`}
              >
                <span>{l.flag}</span>
                <span>{l.nativeName}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-neutral-100 dark:border-neutral-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500">
      <p>© {new Date().getFullYear()} ttaptempo.com. All rights reserved. Free online utility for music creators worldwide.</p>
      <div class="flex items-center gap-4">
        <span>No Cookies • No Tracking</span>
        <span>•</span>
        <span>Client-Side Processing</span>
      </div>
    </div>
  </div>
</footer>
