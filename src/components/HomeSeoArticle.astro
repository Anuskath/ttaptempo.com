---
import { FAQS } from '../data/faqs';
import { TRANSLATIONS } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const data = TRANSLATIONS[lang] || TRANSLATIONS.en;
const art = data.article || TRANSLATIONS.en.article;
const faqs = (data.faqs && data.faqs.length > 0) ? data.faqs : FAQS;
const canonicalUrl = lang === 'en' ? 'https://ttaptempo.com/' : `https://ttaptempo.com/${lang}/`;

// FAQ heading and subtitle localization
const faqHeading = lang === 'es' ? 'Preguntas Frecuentes sobre Tap Tempo y BPM' :
  lang === 'pt' ? 'Perguntas Frequentes sobre Tap Tempo e BPM' :
  lang === 'ja' ? 'タップテンポとBPMに関するよくある質問' :
  lang === 'de' ? 'Häufig gestellte Fragen zu Tap Tempo & BPM' :
  lang === 'fr' ? 'Foire Aux Questions sur le Tap Tempo & BPM' :
  lang === 'ko' ? '탭 템포 및 BPM 자주 묻는 질문' :
  lang === 'it' ? 'Domande Frequenti su Tap Tempo e BPM' :
  'Everything You Need to Know About Tap Tempo & BPM';

const faqSubtitle = lang === 'es' ? 'Respuestas detalladas sobre cálculo de tempo, marcas italianas, pedales de delay y producción musical en DAW.' :
  lang === 'pt' ? 'Respostas detalhadas sobre cálculo de andamento, marcas italianas, pedais de delay e produção musical.' :
  lang === 'ja' ? 'テンポの計算方法、イタリア語速度標語、ディレイ同期、DAWでの活用に関する技術解説。' :
  lang === 'de' ? 'Detaillierte Antworten zu Tempoberechnung, italienischen Tempobezeichnungen, Delay-Pedalen und DAW-Workflows.' :
  lang === 'fr' ? 'Réponses techniques détaillées sur le calcul du tempo, les termes italiens, la synchronisation delay et les DAW.' :
  lang === 'ko' ? '템포 계산 알고리즘, 이탈리아어 템포 기호, 딜레이 페달 동기화 및 DAW 활용법에 관한 상세 안내.' :
  lang === 'it' ? 'Risposte tecniche approfondite su calcolo del tempo, andamenti italiani, pedali delay e workflow DAW.' :
  'In-depth technical answers regarding tempo calculation, classical Italian markings, delay pedal synchronization, and digital audio workstation workflows.';

const whyChooseTitle = lang === 'es' ? '¿Por qué Elegir ttaptempo.com?' :
  lang === 'pt' ? 'Por que Escolher o ttaptempo.com?' :
  lang === 'ja' ? 'ttaptempo.com が選ばれる理由' :
  lang === 'de' ? 'Warum ttaptempo.com wählen?' :
  lang === 'fr' ? 'Pourquoi Choisir ttaptempo.com ?' :
  lang === 'ko' ? 'ttaptempo.com을 선택해야 하는 이유' :
  lang === 'it' ? 'Perché Scegliere ttaptempo.com?' :
  'Why Choose ttaptempo.com Over Other Tools?';

const whyChooseIntro = lang === 'es' ? 'A diferencia de herramientas obsoletas o sitios repletos de publicidad invasiva, ttaptempo.com ofrece una experiencia moderna, ultrarrápida y profesional:' :
  lang === 'pt' ? 'Diferente de sites antigos ou plataformas cheias de anúncios intrusivos, o ttaptempo.com entrega uma experiência moderna, ultra rápida e profissional:' :
  lang === 'ja' ? '広告や登録を強制する古いツールとは異なり、ttaptempo.com はミュージシャンやクリエイター向けに最速で快適な体験を提供します：' :
  lang === 'de' ? 'Im Gegensatz zu veralteten Websites mit störender Werbung bietet ttaptempo.com ein modernes, schnelles und werbefreies Erlebnis auf Studio-Niveau:' :
  lang === 'fr' ? 'Contrairement aux outils obsolètes remplis de publicités intrusives, ttaptempo.com offre une expérience moderne, fluide et professionnelle :' :
  lang === 'ko' ? '광고로 가득 찬 구형 웹사이트들과 달리, ttaptempo.com은 최신 웹 기술 기반으로 빠르고 직관적인 스튜디오급 환경을 제공합니다:' :
  lang === 'it' ? 'A differenza dei vecchi siti pieni di banner pubblicitari, ttaptempo.com offre un\'esperienza moderna, ultraveloce e di livello professionale:' :
  'Unlike legacy tools built decades ago or modern corporate sites cluttered with intrusive advertising and mandatory signups, ttaptempo.com delivers a streamlined, developer-grade experience built on modern web standards:';

const whyChoosePoints = lang === 'es' ? [
  { title: '100% Gratis y Sin Registro:', desc: 'Sin pagos ocultos, sin barreras de inicio de sesión y con uso completamente ilimitado.' },
  { title: 'Cero Latencia en el Navegador:', desc: 'Creado con Astro y Tailwind CSS v4 para cargar en menos de 100 ms a nivel global.' },
  { title: 'Optimizado para Móviles con Háptica:', desc: 'Vibración táctil realista al pulsar en iOS o Android.' },
  { title: 'Privacidad Garantizada:', desc: 'Sin micrófonos ni rastreadores: tus datos se procesan exclusivamente en tu dispositivo.' }
] : lang === 'pt' ? [
  { title: '100% Gratuito e Sem Registro:', desc: 'Sem planos pagos, sem necessidade de login e sem limites de uso.' },
  { title: 'Zero Latência no Navegador:', desc: 'Desenvolvido com Astro e Tailwind CSS v4 para carregar em menos de 100 ms globalmente.' },
  { title: 'Experiência Móvel com Resposta Tátil:', desc: 'Vibração tátil ao tocar no iOS ou Android.' },
  { title: 'Privacidade Total:', desc: 'Sem necessidade de microfone ou cookies rastreadores: processamento 100% local.' }
] : lang === 'ja' ? [
  { title: '完全無料・登録不要:', desc: '有料プランやログインは一切不要。すべての機能を無制限に利用可能。' },
  { title: '超低レイテンシー:', desc: 'AstroとTailwind CSS v4による軽量設計で世界中どこからでも100ms未満で高速読み込み。' },
  { title: 'モバイル対応・触覚フィードバック:', desc: 'スマホタップ時にリアルな振動フィードバックを提供（iOS/Android対応）。' },
  { title: 'プライバシー保護:', desc: 'マイク録音やトラッキングクッキーなし。ブラウザ内で完全に処理。' }
] : lang === 'de' ? [
  { title: '100% Kostenlos & Ohne Anmeldung:', desc: 'Keine Abonnements, keine Registrierungspflicht, unbegrenzte Nutzung.' },
  { title: 'Null Audio-Latenz:', desc: 'Entwickelt mit Astro und Tailwind CSS v4, lädt weltweit in unter 100 ms.' },
  { title: 'Mobiloptimiert mit Haptik:', desc: 'Realistisches taktiles Vibrationsfeedback beim Tippen auf Smartphones.' },
  { title: 'Datenschutz Garantiert:', desc: 'Kein Mikrofonzugriff, keine Tracking-Cookies – 100% lokale Berechnung.' }
] : lang === 'fr' ? [
  { title: '100% Gratuit et Sans Inscription:', desc: 'Aucun abonnement, aucune connexion requise et utilisation illimitée.' },
  { title: 'Zéro Latence Côté Client:', desc: 'Propulsé par Astro et Tailwind CSS v4, se charge en moins de 100 ms dans le monde entier.' },
  { title: 'Mobile First avec Retour Haptique:', desc: 'Vibration tactile réaliste lors des frappes sur iOS et Android.' },
  { title: 'Confidentialité Garantie:', desc: 'Aucun accès micro ni cookie de suivi requis : traitement 100% local.' }
] : lang === 'ko' ? [
  { title: '100% 무료 및 회원가입 없음:', desc: '유료 구독이나 로그인 절차 없이 모든 기능을 무제한으로 사용하세요.' },
  { title: '제로 레이턴시 클라이언트 구조:', desc: 'Astro와 Tailwind CSS v4 기반으로 전 세계 어디서든 100ms 미만 초고속 로딩.' },
  { title: '햅틱 진동 피드백 모바일 지원:', desc: '스마트폰 화면을 탭할 때 실감 나는 물리적 진동 반응 지원.' },
  { title: '완벽한 개인정보 보호:', desc: '마이크 녹음이나 추적 쿠키 없이 기기 내에서 100% 로컬 연산.' }
] : lang === 'it' ? [
  { title: '100% Gratuito e Senza Registrazione:', desc: 'Nessun abbonamento a pagamento, nessun login richiesto e utilizzo senza limiti.' },
  { title: 'Zero Latenza:', desc: 'Realizzato con Astro e Tailwind CSS v4, tempi di caricamento inferiori a 100 ms.' },
  { title: 'Mobile First con Feedback Aptico:', desc: 'Vibrazione tattile realistica quando tocchi lo schermo su iOS o Android.' },
  { title: 'Privacy Garantita:', desc: 'Nessun ascolto da microfono né cookie di tracciamento: elaborazione locale al 100%.' }
] : [
  { title: '100% Free & Unrestricted:', desc: 'No subscription paywalls, no login barriers, and no trial limits.' },
  { title: 'Zero Latency Client-Side Architecture:', desc: 'Powered by Astro and Tailwind CSS v4, loading in under 100ms globally.' },
  { title: 'Mobile First with Tactile Haptics:', desc: 'Enjoy realistic drum-pad physical vibration feedback when tapping on iOS or Android.' },
  { title: 'Privacy Guaranteed:', desc: 'No microphone listening or tracking cookies required—your timing data remains strictly on your device.' }
];
---

<section id="guide" class="relative w-full py-16 px-4 border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-black">
  <div class="max-w-4xl mx-auto">
    
    <!-- 800 - 1200 Word Comprehensive SEO Guide -->
    <article class="prose prose-neutral dark:prose-invert max-w-none text-neutral-700 dark:text-neutral-300 leading-relaxed text-sm sm:text-base space-y-8">
      
      <!-- Section 1: Introduction & Main Keyword -->
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-3">
          <span>{art.badge}</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-4">
          {art.h1}
        </h2>
        <p>{art.p1}</p>
        <p>{art.p2}</p>
      </div>

      <!-- Section 2: How It Works & Algorithm -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {art.h2Algorithm}
        </h3>
        <p>{art.pAlgorithm1}</p>
        <p>{art.pAlgorithm2}</p>
        
        <!-- Formula Box -->
        <div class="p-5 my-4 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/60 font-mono text-center not-prose">
          <div class="text-xs uppercase tracking-wider text-neutral-500 mb-1">{art.formulaTitle}</div>
          <div class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100">
            {art.formulaText}
          </div>
          <div class="text-xs text-neutral-500 mt-1">
            {art.formulaExample}
          </div>
        </div>
      </div>

      <!-- Section 3: Metronome Integration -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {art.h2Metronome}
        </h3>
        <p>{art.pMetronome}</p>
      </div>

      <!-- Section 4: Delay Pedal with Tap Tempo & DAW Sync -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {art.h2Delay}
        </h3>
        <p>{art.pDelay}</p>
        <ul class="list-disc pl-6 space-y-2">
          {art.delayPoints && art.delayPoints.map(point => (
            <li>{point}</li>
          ))}
        </ul>
      </div>

      <!-- Section 5: Step-by-Step Tapping Guide -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {art.h2Steps}
        </h3>
        <ol class="list-decimal pl-6 space-y-2">
          {art.steps && art.steps.map(step => (
            <li>{step}</li>
          ))}
        </ol>
      </div>

      <!-- Section 6: Italian Tempo Markings Reference -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {data.ui.tempoGuideTitle || "Understanding Classical Italian Tempo Markings"}
        </h3>
        <p>
          {data.ui.tempoGuideSubtitle || "Classical composers used expressive Italian terms to designate musical pace centuries before digital metronomes were invented. Our tool dynamically categorizes every tap tempo measurement into its historical classification:"}
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Grave (25–44 BPM):</strong> Slow, solemn, and weighty.</li>
          <li><strong>Largo (45–59 BPM):</strong> Broad, stately, and dignified.</li>
          <li><strong>Adagio (66–75 BPM):</strong> Slow and leisurely, expressing deep emotion.</li>
          <li><strong>Andante (76–107 BPM):</strong> A natural walking tempo, flowing moderately.</li>
          <li><strong>Moderato (108–119 BPM):</strong> A balanced, comfortable medium speed.</li>
          <li><strong>Allegro (128–155 BPM):</strong> Fast, lively, bright, and spirited.</li>
          <li><strong>Vivace (156–175 BPM):</strong> Brisk, energetic, and rapid.</li>
          <li><strong>Presto (176–199 BPM):</strong> Very fast, driven with momentum.</li>
          <li><strong>Prestissimo (200+ BPM):</strong> The ultimate ceiling of musical speed.</li>
        </ul>
      </div>

      <!-- Section 7: Modern Music Genre Tempo Cheat Sheet -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          BPM Ranges by Contemporary Music Genre
        </h3>
        <p>
          Every musical genre has an inherent speed window that defines its groove and danceability. Here is a quick reference table of standard tempos:
        </p>
        <div class="overflow-x-auto not-prose my-4">
          <table class="w-full text-left text-xs sm:text-sm border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden">
            <thead class="bg-neutral-50 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 font-semibold border-b border-neutral-200 dark:border-neutral-800">
              <tr>
                <th class="py-2.5 px-4">Music Genre</th>
                <th class="py-2.5 px-4">Standard BPM Range</th>
                <th class="py-2.5 px-4">Rhythmic Characteristics</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 dark:divide-neutral-900 font-mono text-neutral-700 dark:text-neutral-300">
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">Lo-Fi &amp; Downtempo</td>
                <td class="py-2.5 px-4">70 – 85 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Relaxed swung hip-hop drums, tape warble</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">Classic Hip-Hop &amp; Boom Bap</td>
                <td class="py-2.5 px-4">85 – 95 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Punchy snares, breakbeats, head-bobbing groove</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">Modern Pop &amp; R&amp;B</td>
                <td class="py-2.5 px-4">100 – 118 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Radio-friendly, upbeat verse-chorus transitions</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">House, EDM &amp; Techno</td>
                <td class="py-2.5 px-4">120 – 130 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Four-on-the-floor kick, driving offbeat open hi-hats</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">Trap &amp; Dubstep</td>
                <td class="py-2.5 px-4">140 – 150 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Half-time feel (70–75 BPM feel), rolling 808s</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-sans font-medium text-neutral-900 dark:text-neutral-100">Drum &amp; Bass / Jungle</td>
                <td class="py-2.5 px-4">165 – 178 BPM</td>
                <td class="py-2.5 px-4 font-sans text-neutral-500">Rapid syncopated breakbeats, heavy sub-basslines</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 8: Why Choose ttaptempo.com -->
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {whyChooseTitle}
        </h3>
        <p>
          {whyChooseIntro}
        </p>
        <ul class="list-disc pl-6 space-y-2">
          {whyChoosePoints.map(point => (
            <li><strong>{point.title}</strong> {point.desc}</li>
          ))}
        </ul>
      </div>

    </article>

    <!-- Frequently Asked Questions Accordion -->
    <div id="faq" class="mt-16 pt-12 border-t border-neutral-200 dark:border-neutral-800 scroll-mt-20">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-3">
          <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Frequently Asked Questions</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
          {faqHeading}
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2 max-w-xl mx-auto">
          {faqSubtitle}
        </p>
      </div>

      <div class="space-y-3 max-w-3xl mx-auto">
        {faqs.map((faq, index) => (
          <details class="group rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-4 sm:p-5 transition-all duration-200 hover:border-neutral-300 dark:hover:border-neutral-700 open:bg-neutral-50/70 dark:open:bg-neutral-900/90 open:border-neutral-300 dark:open:border-neutral-700">
            <summary class="flex items-start sm:items-center justify-between cursor-pointer list-none select-none min-h-[44px]">
              <div class="flex items-start sm:items-center gap-3 pr-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-mono font-medium text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-neutral-800 shrink-0 mt-0.5 sm:mt-0">
                  {index + 1}
                </span>
                <div>
                  {faq.category && (
                    <span class="inline-block text-[10px] font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold mb-0.5">
                      {faq.category}
                    </span>
                  )}
                  <h3 class="font-semibold text-sm sm:text-base text-neutral-900 dark:text-neutral-100 leading-snug">
                    {faq.question}
                  </h3>
                </div>
              </div>
              <span class="ml-2 transition-transform duration-200 group-open:rotate-180 text-neutral-400 dark:text-neutral-500 shrink-0 p-1">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="mt-3.5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed border-t border-neutral-100 dark:border-neutral-800/80 pt-3.5 pl-9 sm:pl-9 break-words">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- JSON-LD WebApplication Schema for Google Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${canonicalUrl}#webapp`,
  "name": data.meta?.title || "Tap Tempo - Online BPM Counter & Metronome",
  "url": canonicalUrl,
  "inLanguage": lang,
  "applicationCategory": "MusicApplication",
  "operatingSystem": "All (Web Browser, iOS, Android, macOS, Windows, Linux)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": data.meta?.description || "Free online tap tempo and BPM counter tool."
})} />

<!-- Dedicated JSON-LD FAQPage Schema for Google SERP Rich Snippets Accordions -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `<p>${faq.answer}</p>`
    }
  }))
})} />
