---
import { TEMPO_MARKINGS, GENRE_BPMS } from '../data/tempoData';
---

<section id="tempo-guide" class="relative w-full py-12 px-4 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40">
  <div class="max-w-4xl mx-auto">
    
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-xs font-mono font-medium text-neutral-600 dark:text-neutral-400 mb-2">
        <span>Music Theory Reference</span>
        <span>•</span>
        <span>Standard Speed Markings</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Musical Tempo Markings &amp; Genre BPM Guide
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
        Learn classical Italian tempo speeds and standard modern music production genre BPM ranges. Click any row to load that tempo into the tool.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Left: Classical Italian Tempo Markings -->
      <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 sm:p-6 shadow-sm">
        <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-4 flex items-center justify-between">
          <span>Classical Italian Markings</span>
          <span class="text-xs font-mono font-normal text-neutral-500">Speed (BPM)</span>
        </h3>

        <div class="space-y-2">
          {TEMPO_MARKINGS.map((item) => (
            <button
              type="button"
              class="tempo-guide-row w-full text-left p-3 rounded-xl border border-neutral-100 dark:border-neutral-800/60 bg-neutral-50/50 dark:bg-neutral-950/40 hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors flex items-center justify-between group cursor-pointer"
              data-bpm={Math.round((item.min + (item.max === 999 ? 200 : item.max)) / 2)}
            >
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {item.name}
                  </span>
                  <span class="text-xs text-neutral-400 font-normal italic">
                    "{item.italianMeaning}"
                  </span>
                </div>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 block mt-0.5">
                  {item.description}
                </span>
              </div>
              <div class="text-right pl-3 shrink-0">
                <span class="font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 px-2 py-1 rounded bg-neutral-200/50 dark:bg-neutral-800">
                  {item.min}–{item.max === 999 ? '200+' : item.max}
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Right: Modern Genre BPM Guide -->
      <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 sm:p-6 shadow-sm">
        <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-4 flex items-center justify-between">
          <span>Modern Music Genres</span>
          <span class="text-xs font-mono font-normal text-neutral-500">Typical BPM</span>
        </h3>

        <div class="space-y-2">
          {GENRE_BPMS.map((item) => (
            <button
              type="button"
              class="tempo-guide-row w-full text-left p-3 rounded-xl border border-neutral-100 dark:border-neutral-800/60 bg-neutral-50/50 dark:bg-neutral-950/40 hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors flex items-center justify-between group cursor-pointer"
              data-bpm={Math.round((item.min + (item.max === 999 ? 200 : item.max)) / 2)}
            >
              <div>
                <span class="font-bold text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors block">
                  {item.genre}
                </span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 block mt-0.5">
                  {item.example}
                </span>
              </div>
              <div class="text-right pl-3 shrink-0">
                <span class="font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 px-2 py-1 rounded bg-neutral-200/50 dark:bg-neutral-800">
                  {item.min}–{item.max === 999 ? '200+' : item.max}
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.tempo-guide-row').forEach(row => {
    row.addEventListener('click', () => {
      const bpm = parseInt(row.getAttribute('data-bpm') || '120', 10);
      window.dispatchEvent(new CustomEvent('set-manual-bpm', { detail: { bpm } }));
      // Smooth scroll back to top tap tool
      const tool = document.getElementById('tap-tool');
      if (tool) {
        tool.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
