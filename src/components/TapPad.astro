---
import { TRANSLATIONS } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = TRANSLATIONS[lang]?.ui || TRANSLATIONS.en.ui;
---

<section id="tap-tool" class="relative w-full pt-8 pb-12 sm:pt-12 sm:pb-16 px-4 aurora-mesh-light">
  <div class="max-w-4xl mx-auto">
    <!-- Hero Title & Value Proposition -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xs text-xs font-mono font-medium text-neutral-600 dark:text-neutral-400 mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {t.heroBadge}
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-3">
        {t.heroTitlePrefix} <span class="rainbow-gradient-text">{t.heroTitleGradient}</span> &amp; BPM Counter
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
        {t.heroSubtitle}
      </p>
    </div>

    <!-- Main Tap Card Container -->
    <div class="relative rounded-3xl border border-neutral-200/80 dark:border-neutral-800 bg-white/90 dark:bg-neutral-950/90 backdrop-blur-md p-6 sm:p-8 shadow-2xl shadow-blue-500/5 dark:shadow-none transition-all duration-200">
      
      <!-- Top Readout Bar: Hero BPM & Tempo Classification -->
      <div class="flex flex-col items-center justify-center text-center pb-6 border-b border-neutral-100 dark:border-neutral-800/80">
        
        <!-- Classical Italian Marking & Genre Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-3">
          <span id="tempo-marking-badge" class="px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors border border-neutral-200/60 dark:border-neutral-700/60">
            {t.tapInitial}
          </span>
          <span id="genre-badge" class="hidden px-3.5 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50">
            <!-- Dynamic Genre -->
          </span>
        </div>

        <!-- Big Hero BPM Number -->
        <div class="relative inline-flex items-baseline justify-center gap-2 select-none">
          <span id="bpm-display" class="font-mono text-7xl sm:text-8xl lg:text-9xl font-black tracking-tighter text-neutral-950 dark:text-neutral-50 transition-transform duration-75">
            0
          </span>
          <span class="text-xl sm:text-2xl font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-600">
            BPM
          </span>
        </div>

        <!-- Consistency Quality Bar -->
        <div id="consistency-container" class="mt-2 flex items-center gap-2 text-xs font-mono text-neutral-500 opacity-0 transition-opacity duration-200" data-steady={t.steady}>
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="consistency-text">100% {t.steady}</span>
        </div>
      </div>

      <!-- Center Interactive Tap Pad (The Heart of the Tool) -->
      <div class="py-8 sm:py-10 flex flex-col items-center justify-center">
        <div class="rainbow-border-wrap w-full max-w-lg shadow-xl shadow-blue-500/10 dark:shadow-none">
          <button
            id="tap-pad-button"
            type="button"
            class="relative w-full h-56 sm:h-64 rounded-[calc(1.5rem-1.5px)] bg-gradient-to-b from-white to-neutral-50 dark:from-neutral-900 dark:to-neutral-950 flex flex-col items-center justify-center text-center p-6 cursor-pointer select-none transition-all duration-75 active:scale-[0.985] shadow-inner focus:outline-none focus:ring-4 focus:ring-blue-400/20 dark:focus:ring-purple-600/30 overflow-hidden group touch-manipulation"
            aria-label="Tap to measure BPM or press spacebar"
          >
            <!-- Dynamic Concentric Ripple Waves -->
            <div id="tap-ripples" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

          <!-- Central Visual Pulse Icon -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black flex items-center justify-center mb-4 shadow-lg group-active:scale-95 transition-transform duration-75">
            <svg id="tap-pulse-icon" class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>

          <span class="font-extrabold text-lg sm:text-xl tracking-tight text-neutral-900 dark:text-neutral-100 uppercase">
            {t.tapButtonMain}
          </span>
          <span class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1 font-medium">
            {t.tapButtonSub}
          </span>

          <!-- Keyboard helper badge -->
          <div class="hidden sm:inline-flex items-center gap-1.5 mt-4 px-2.5 py-1 rounded bg-neutral-200/60 dark:bg-neutral-800/80 text-[11px] font-mono text-neutral-600 dark:text-neutral-400">
            <span>{t.helperBadge}</span>
            <span>•</span>
            <kbd class="px-1 py-0.5 rounded bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 shadow-xs">R</kbd>
          </div>
        </button>
      </div>
    </div>

      <!-- Quick Nudge Buttons (-5, -1, +1, +5) & Reset Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-800/80">
        
        <!-- Nudge Controls -->
        <div class="flex items-center gap-1.5">
          <span class="text-xs text-neutral-500 font-medium mr-1 hidden sm:inline">{t.nudgeLabel}</span>
          <button id="nudge-minus-5" type="button" class="px-2.5 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer" title="Decrease 5 BPM">-5</button>
          <button id="nudge-minus-1" type="button" class="px-2.5 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer" title="Decrease 1 BPM">-1</button>
          <button id="nudge-plus-1" type="button" class="px-2.5 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer" title="Increase 1 BPM">+1</button>
          <button id="nudge-plus-5" type="button" class="px-2.5 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer" title="Increase 5 BPM">+5</button>
        </div>

        <!-- Action Tools: Copy & Reset -->
        <div class="flex items-center gap-2">
          <!-- Copy BPM Button -->
          <button 
            id="copy-bpm-btn" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-text">Copy BPM</span>
          </button>

          <!-- Reset Button -->
          <button 
            id="reset-btn" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/50 text-xs font-medium hover:bg-red-100 dark:hover:bg-red-900/60 transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t.resetLabel} (R)</span>
          </button>
        </div>
      </div>

      <!-- Advanced Settings Row (Decimal toggle, Auto-reset timeout) -->
      <div class="mt-4 pt-3 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-600 dark:text-neutral-400 border-t border-neutral-100 dark:border-neutral-900">
        <!-- Precision Toggle -->
        <label class="flex items-center gap-2 cursor-pointer select-none">
          <input id="decimal-toggle" type="checkbox" class="w-4 h-4 rounded border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 focus:ring-neutral-500 accent-neutral-900 dark:accent-neutral-100">
          <span>Show 1 Decimal Place</span>
        </label>

        <!-- Auto-Reset Dropdown -->
        <div class="flex items-center gap-2">
          <span>Auto-Reset Inactivity:</span>
          <select id="auto-reset-select" class="rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 px-2 py-1 text-xs text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-400">
            <option value="2000">2 Seconds</option>
            <option value="3000" selected>3 Seconds</option>
            <option value="5000">5 Seconds</option>
            <option value="0">Never (Manual)</option>
          </select>
        </div>
      </div>

    </div>

    <!-- Live Statistics Cards (Interval, Frequency, Tap Count) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-6">
      
      <div class="p-4 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
        <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 block mb-1">{t.statsInterval}</span>
        <div class="flex items-baseline gap-1">
          <span id="stat-interval" class="font-mono text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">0</span>
          <span class="text-xs font-mono text-neutral-500">ms</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
        <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 block mb-1">{t.statsFrequency}</span>
        <div class="flex items-baseline gap-1">
          <span id="stat-hz" class="font-mono text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">0</span>
          <span class="text-xs font-mono text-neutral-500">Hz</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
        <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 block mb-1">{t.statsTaps}</span>
        <div class="flex items-baseline gap-1">
          <span id="stat-taps" class="font-mono text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">0</span>
          <span class="text-xs font-mono text-neutral-500">beats</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
        <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 block mb-1">{t.statsConsistency}</span>
        <div class="flex items-baseline gap-1">
          <span id="stat-elapsed" class="font-mono text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">0.0</span>
          <span class="text-xs font-mono text-neutral-500">sec</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes rippleEffect {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .tap-ripple-circle {
    position: absolute;
    border-radius: 9999px;
    pointer-events: none;
    animation: rippleEffect 0.6s cubic-bezier(0, 0.2, 0.8, 1) forwards;
  }
</style>

<script>
  import { getTempoMarking, getMatchingGenres } from '../data/tempoData';

  // State variables
  let tapTimestamps: number[] = [];
  let currentBpm = 0;
  let showDecimals = false;
  let autoResetMs = 3000;
  let autoResetTimer: number | null = null;
  let elapsedTimer: number | null = null;
  let sessionStartTime = 0;

  // DOM Elements
  const bpmDisplay = document.getElementById('bpm-display') as HTMLElement;
  const tapPadBtn = document.getElementById('tap-pad-button') as HTMLButtonElement;
  const tapRipples = document.getElementById('tap-ripples') as HTMLElement;
  const tempoMarkingBadge = document.getElementById('tempo-marking-badge') as HTMLElement;
  const genreBadge = document.getElementById('genre-badge') as HTMLElement;
  const consistencyContainer = document.getElementById('consistency-container') as HTMLElement;
  const consistencyText = document.getElementById('consistency-text') as HTMLElement;
  const statInterval = document.getElementById('stat-interval') as HTMLElement;
  const statHz = document.getElementById('stat-hz') as HTMLElement;
  const statTaps = document.getElementById('stat-taps') as HTMLElement;
  const statElapsed = document.getElementById('stat-elapsed') as HTMLElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const copyBpmBtn = document.getElementById('copy-bpm-btn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('copy-btn-text') as HTMLElement;
  const decimalToggle = document.getElementById('decimal-toggle') as HTMLInputElement;
  const autoResetSelect = document.getElementById('auto-reset-select') as HTMLSelectElement;

  const nudgeMinus5 = document.getElementById('nudge-minus-5') as HTMLButtonElement;
  const nudgeMinus1 = document.getElementById('nudge-minus-1') as HTMLButtonElement;
  const nudgePlus1 = document.getElementById('nudge-plus-1') as HTMLButtonElement;
  const nudgePlus5 = document.getElementById('nudge-plus-5') as HTMLButtonElement;

  // Dispatch BPM update event to sync with Metronome & Delay Calculator
  function dispatchBpmUpdate(bpm: number) {
    window.dispatchEvent(new CustomEvent('bpm-change', { detail: { bpm } }));
  }

  // Handle a new tap
  function handleTap() {
    const now = performance.now();

    // Haptic feedback on supported mobile devices
    if ('vibrate' in navigator) {
      try {
        navigator.vibrate(25);
      } catch (e) {
        // ignore
      }
    }

    // Spawn visual ripple
    createRipple();

    // Check if inactivity timeout exceeded -> start fresh session
    if (autoResetMs > 0 && tapTimestamps.length > 0) {
      const timeSinceLastTap = now - tapTimestamps[tapTimestamps.length - 1];
      if (timeSinceLastTap > autoResetMs) {
        resetSession(false);
      }
    }

    // Add timestamp
    tapTimestamps.push(now);

    // Start elapsed timer on first tap
    if (tapTimestamps.length === 1) {
      sessionStartTime = now;
      if (elapsedTimer) clearInterval(elapsedTimer);
      elapsedTimer = window.setInterval(() => {
        const sec = ((performance.now() - sessionStartTime) / 1000).toFixed(1);
        statElapsed.textContent = sec;
      }, 100);
    }

    // Schedule auto-reset timer
    if (autoResetMs > 0) {
      if (autoResetTimer) clearTimeout(autoResetTimer);
      autoResetTimer = window.setTimeout(() => {
        // Stop elapsed timer on timeout
        if (elapsedTimer) {
          clearInterval(elapsedTimer);
          elapsedTimer = null;
        }
      }, autoResetMs);
    }

    // Calculate BPM if at least 2 taps exist
    if (tapTimestamps.length >= 2) {
      // Calculate intervals between consecutive taps
      const intervals: number[] = [];
      for (let i = 1; i < tapTimestamps.length; i++) {
        intervals.push(tapTimestamps[i] - tapTimestamps[i - 1]);
      }

      // To improve accuracy, take the last 16 intervals if more exist
      const recentIntervals = intervals.slice(-16);
      const avgInterval = recentIntervals.reduce((a, b) => a + b, 0) / recentIntervals.length;

      // BPM = 60,000 / avgInterval (ms)
      currentBpm = 60000 / avgInterval;
      currentBpm = Math.max(1, Math.min(999, currentBpm));

      // Calculate consistency (standard deviation / mean)
      if (recentIntervals.length >= 3) {
        const variance = recentIntervals.reduce((sum, val) => sum + Math.pow(val - avgInterval, 2), 0) / recentIntervals.length;
        const stdDev = Math.sqrt(variance);
        const consistency = Math.max(0, Math.min(100, Math.round(100 - (stdDev / avgInterval) * 100)));
        consistencyContainer.style.opacity = '1';
        consistencyText.textContent = `${consistency}% Steady Rhythm`;
      }

      updateUI();
      dispatchBpmUpdate(currentBpm);
    } else {
      // First tap
      bpmDisplay.textContent = '...';
      tempoMarkingBadge.textContent = 'Keep tapping to measure...';
      statTaps.textContent = '1';
      statInterval.textContent = '--';
      statHz.textContent = '--';
    }
  }

  function updateUI() {
    if (currentBpm <= 0) {
      bpmDisplay.textContent = '0';
      tempoMarkingBadge.textContent = 'Tap to measure tempo';
      genreBadge.classList.add('hidden');
      statInterval.textContent = '0';
      statHz.textContent = '0';
      statTaps.textContent = '0';
      return;
    }

    // Formatted BPM
    bpmDisplay.textContent = showDecimals ? currentBpm.toFixed(1) : Math.round(currentBpm).toString();

    // Stats
    const intervalMs = (60000 / currentBpm).toFixed(1);
    const hz = (currentBpm / 60).toFixed(2);
    statInterval.textContent = intervalMs;
    statHz.textContent = hz;
    statTaps.textContent = tapTimestamps.length.toString();

    // Tempo Marking
    const marking = getTempoMarking(currentBpm);
    tempoMarkingBadge.textContent = `${marking.name} (${marking.min}–${marking.max === 999 ? '200+' : marking.max} BPM) • ${marking.description}`;

    // Genre Matches
    const genres = getMatchingGenres(currentBpm);
    if (genres.length > 0) {
      genreBadge.classList.remove('hidden');
      genreBadge.textContent = genres.map(g => g.genre).join(' / ');
    } else {
      genreBadge.classList.add('hidden');
    }
  }

  function resetSession(resetDisplay = true) {
    tapTimestamps = [];
    if (autoResetTimer) {
      clearTimeout(autoResetTimer);
      autoResetTimer = null;
    }
    if (elapsedTimer) {
      clearInterval(elapsedTimer);
      elapsedTimer = null;
    }
    statElapsed.textContent = '0.0';
    consistencyContainer.style.opacity = '0';

    if (resetDisplay) {
      currentBpm = 0;
      updateUI();
      dispatchBpmUpdate(0);
    }
  }

  const rainbowColors = [
    'bg-cyan-500/25 dark:bg-cyan-400/25',
    'bg-blue-500/25 dark:bg-blue-400/25',
    'bg-purple-500/25 dark:bg-purple-400/25',
    'bg-pink-500/25 dark:bg-pink-400/25',
    'bg-amber-500/25 dark:bg-amber-400/25',
    'bg-emerald-500/25 dark:bg-emerald-400/25'
  ];

  function createRipple() {
    const circle = document.createElement('div');
    const colorClass = rainbowColors[tapTimestamps.length % rainbowColors.length];
    circle.className = `tap-ripple-circle ${colorClass}`;
    const size = Math.max(tapPadBtn.clientWidth, tapPadBtn.clientHeight);
    circle.style.width = `${size}px`;
    circle.style.height = `${size}px`;
    circle.style.left = `${tapPadBtn.clientWidth / 2 - size / 2}px`;
    circle.style.top = `${tapPadBtn.clientHeight / 2 - size / 2}px`;

    tapRipples.appendChild(circle);
    setTimeout(() => circle.remove(), 600);
  }

  function nudgeBpm(delta: number) {
    if (currentBpm === 0) currentBpm = 120;
    currentBpm = Math.max(20, Math.min(360, currentBpm + delta));
    updateUI();
    dispatchBpmUpdate(currentBpm);
  }

  // Event Listeners
  tapPadBtn.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    handleTap();
  });

  // Global Keyboard Listener
  window.addEventListener('keydown', (e) => {
    // If active element is an input or select, don't hijack keys
    const tag = (document.activeElement?.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'select' || tag === 'textarea') return;

    if (e.code === 'Space') {
      e.preventDefault();
      handleTap();
    } else if (e.key === 'r' || e.key === 'R') {
      e.preventDefault();
      resetSession(true);
    } else if (e.code === 'ArrowUp') {
      e.preventDefault();
      nudgeBpm(1);
    } else if (e.code === 'ArrowDown') {
      e.preventDefault();
      nudgeBpm(-1);
    }
  });

  resetBtn.addEventListener('click', () => resetSession(true));

  nudgeMinus5.addEventListener('click', () => nudgeBpm(-5));
  nudgeMinus1.addEventListener('click', () => nudgeBpm(-1));
  nudgePlus1.addEventListener('click', () => nudgeBpm(1));
  nudgePlus5.addEventListener('click', () => nudgeBpm(5));

  decimalToggle.addEventListener('change', () => {
    showDecimals = decimalToggle.checked;
    updateUI();
  });

  autoResetSelect.addEventListener('change', () => {
    autoResetMs = parseInt(autoResetSelect.value, 10);
  });

  copyBpmBtn.addEventListener('click', () => {
    if (currentBpm <= 0) return;
    const textToCopy = showDecimals ? currentBpm.toFixed(1) : Math.round(currentBpm).toString();
    navigator.clipboard.writeText(textToCopy).then(() => {
      copyBtnText.textContent = 'Copied!';
      setTimeout(() => (copyBtnText.textContent = 'Copy BPM'), 1500);
    });
  });

  // Listen to external manual BPM changes (e.g. from metronome sliders)
  window.addEventListener('set-manual-bpm', ((e: CustomEvent) => {
    currentBpm = e.detail.bpm;
    updateUI();
    dispatchBpmUpdate(currentBpm);
  }) as EventListener);
</script>
