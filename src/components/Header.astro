---
import { LANGUAGES, SUPPORTED_LANG_CODES, getLanguagePath } from '../i18n/languages';
import { TRANSLATIONS } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const currentLanguage = LANGUAGES[lang] || LANGUAGES.en;
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
const homePath = getLanguagePath(lang);
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-black/80 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href={homePath} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-lg bg-neutral-900 dark:bg-neutral-100 flex items-center justify-center text-white dark:text-black shadow-sm group-hover:scale-105 transition-transform duration-200">
        <!-- Modern Sound Wave / Metronome Icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 10v4"></path>
          <path d="M6 7v10"></path>
          <path d="M10 4v16"></path>
          <path d="M14 8v8"></path>
          <path d="M18 6v12"></path>
          <path d="M22 10v4"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-lg tracking-tight text-neutral-900 dark:text-neutral-50">Tap Tempo</span>
          <span class="text-xs px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 font-mono font-medium">.com</span>
        </div>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden lg:flex items-center gap-5 text-sm font-medium text-neutral-600 dark:text-neutral-400">
      <a href={homePath} class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Tap Tempo</a>
      <a href="/bpm-counter/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">BPM Counter</a>
      <a href="/online-metronome/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Metronome</a>
      <a href="/delay-calculator/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Delay Sync</a>
      <a href={`${homePath}#tempo-guide`} class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Tempo Guide</a>
      <a href={`${homePath}#faq`} class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">FAQs</a>
    </nav>

    <!-- Right Controls: Language Selector, Theme Toggle & Mobile Menu -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      
      <!-- Free Badge (hidden on small mobile) -->
      <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        100% Free
      </span>

      <!-- Language Selector Dropdown (Desktop & Tablet) -->
      <div class="relative" id="lang-dropdown-container">
        <button
          id="lang-toggle-btn"
          type="button"
          aria-label="Change Language"
          class="h-9 px-2.5 rounded-lg border border-neutral-200 dark:border-neutral-800 flex items-center gap-1.5 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer"
        >
          <span class="text-sm">{currentLanguage.flag}</span>
          <span class="font-mono uppercase hidden xs:inline">{currentLanguage.code}</span>
          <svg class="w-3.5 h-3.5 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-48 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xl py-1.5 z-50"
        >
          <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-neutral-400 border-b border-neutral-100 dark:border-neutral-800">
            Select Language
          </div>
          {SUPPORTED_LANG_CODES.map((code) => {
            const langObj = LANGUAGES[code];
            const isCurrent = code === lang;
            return (
              <a
                href={langObj.path}
                class={`flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors ${
                  isCurrent
                    ? 'bg-neutral-100 dark:bg-neutral-800 text-neutral-950 dark:text-neutral-50 font-bold'
                    : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-50 dark:hover:bg-neutral-800/60 hover:text-neutral-900 dark:hover:text-neutral-100'
                }`}
              >
                <div class="flex items-center gap-2">
                  <span>{langObj.flag}</span>
                  <span>{langObj.nativeName}</span>
                </div>
                {isCurrent && (
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Dark Mode Toggle Button -->
      <button 
        id="theme-toggle" 
        type="button" 
        aria-label="Toggle dark mode"
        class="w-9 h-9 rounded-lg border border-neutral-200 dark:border-neutral-800 flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer"
      >
        <!-- Sun Icon (shows in dark mode) -->
        <svg id="theme-sun" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon Icon (shows in light mode) -->
        <svg id="theme-moon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open mobile navigation menu"
        class="lg:hidden w-9 h-9 rounded-lg border border-neutral-200 dark:border-neutral-800 flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer"
      >
        <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 dark:border-neutral-800 bg-white/95 dark:bg-black/95 backdrop-blur-lg px-4 py-4 space-y-3">
    
    <!-- Language Selection in Mobile Menu -->
    <div class="pb-3 border-b border-neutral-100 dark:border-neutral-800">
      <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 mb-2">Languages</div>
      <div class="grid grid-cols-4 gap-1.5">
        {SUPPORTED_LANG_CODES.map((code) => {
          const l = LANGUAGES[code];
          const isSelected = code === lang;
          return (
            <a
              href={l.path}
              class={`flex items-center justify-center gap-1 py-1.5 px-2 rounded-lg text-xs font-mono border transition-colors ${
                isSelected
                  ? 'border-emerald-500 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold'
                  : 'border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-900'
              }`}
            >
              <span>{l.flag}</span>
              <span class="uppercase">{l.code}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Navigation links -->
    <div class="space-y-1">
      <a href={homePath} class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>Tap Tempo Tool</span>
        <span class="text-xs text-neutral-400">Home</span>
      </a>
      <a href="/bpm-counter/" class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>BPM Counter &amp; Tapper</span>
        <span class="text-xs text-emerald-500 font-mono">BPM</span>
      </a>
      <a href="/online-metronome/" class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>Online Metronome</span>
        <span class="text-xs text-blue-500 font-mono">Click</span>
      </a>
      <a href="/delay-calculator/" class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>Delay &amp; Reverb Sync</span>
        <span class="text-xs text-purple-500 font-mono">ms</span>
      </a>
      <a href={`${homePath}#tempo-guide`} class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>Tempo Markings Guide</span>
      </a>
      <a href={`${homePath}#faq`} class="flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
        <span>15 SEO FAQs</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 font-mono">Q&amp;A</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  const themeSun = document.getElementById('theme-sun');
  const themeMoon = document.getElementById('theme-moon');

  function updateThemeUI(isDark) {
    if (isDark) {
      document.documentElement.classList.add('dark');
      themeSun?.classList.remove('hidden');
      themeMoon?.classList.add('hidden');
    } else {
      document.documentElement.classList.remove('dark');
      themeSun?.classList.add('hidden');
      themeMoon?.classList.remove('hidden');
    }
  }

  // Initial check
  const savedTheme = localStorage.getItem('theme');
  const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = savedTheme ? savedTheme === 'dark' : systemPrefersDark;
  updateThemeUI(isDark);

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const willBeDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', willBeDark ? 'dark' : 'light');
      updateThemeUI(willBeDark);
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { dark: willBeDark } }));
    });
  }

  // Language Dropdown Toggle
  const langToggleBtn = document.getElementById('lang-toggle-btn');
  const langMenu = document.getElementById('lang-menu');

  if (langToggleBtn && langMenu) {
    langToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!langMenu.contains(e.target)) {
        langMenu.classList.add('hidden');
      }
    });
  }

  // Mobile Navigation Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }
</script>
